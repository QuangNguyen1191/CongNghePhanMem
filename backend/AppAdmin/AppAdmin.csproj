<Project Sdk="Microsoft.NET.Sdk">

  <!-- App desktop admin (WinForms). Lop giao dien goi thang BLL, khong goi DAL (xem backend/README.md) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AppAdmin</RootNamespace>
    <AssemblyName>AppAdmin</AssemblyName>
    <AssemblyTitle>QL Bán Thời Trang - App Admin</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLL\BLL.csproj" />
    <ProjectReference Include="..\DTO\DTO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BLL" />
    <Using Include="DTO" />
    <Using Include="AppAdmin.HaTang" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
